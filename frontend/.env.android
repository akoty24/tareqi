# Used by "npm run build:android" (vite --mode android) for the APK.
# The app cannot use the dev proxy: point it to the Laravel API directly.
# Run the backend with: php artisan serve --host=0.0.0.0 --port=8000
# The address can also be changed inside the app (login screen > Server).
VITE_API_URL=http://172.20.31.1:8000/api

# Set to true only after adding android/app/google-services.json (Firebase).
VITE_PUSH_ENABLED=false
